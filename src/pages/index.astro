---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

// Fetch articles and site settings
const [{ entries: allArticles, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("articles", {
		orderBy: { published_at: "desc" },
		limit: 24,
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Batched query for Categories across all articles
const articleEntryIds = allArticles.map((a) => a.data.id);
const categoriesByEntry = await getTermsForEntries("articles", articleEntryIds, "category");

// Helper to get category for an article
function getArticleCategory(articleId: string) {
	const terms = categoriesByEntry.get(articleId);
	return terms && terms.length > 0 ? terms[0] : { label: "Tafsir Tematik", slug: "tafsir-tematik" };
}

// Helper to format Indonesian dates
function formatDate(date: Date | string | null | undefined) {
	if (!date) return "18 Agustus 2026";
	const d = typeof date === "string" ? new Date(date) : date;
	return d.toLocaleDateString("id-ID", {
		day: "numeric",
		month: "long",
		year: "numeric",
	});
}

// 1. Hero Bento Grid Segmentation
const leadHero = allArticles.find((a) => a.data.is_lead_hero) || allArticles[0];
const secondaryHeroes = allArticles
	.filter((a) => a.data.is_secondary_hero && a.id !== leadHero?.id)
	.slice(0, 4);

// Fallback if secondary hero flags are fewer than 4
const heroSetIds = new Set([leadHero?.id, ...secondaryHeroes.map((a) => a.id)]);
const remainingForHeroes = allArticles.filter((a) => !heroSetIds.has(a.id));
while (secondaryHeroes.length < 4 && remainingForHeroes.length > 0) {
	const next = remainingForHeroes.shift();
	if (next) {
		secondaryHeroes.push(next);
		heroSetIds.add(next.id);
	}
}

// 2. Pattern A (Artikel Pilihan) Segmentation
const patternAArticles = allArticles.filter((a) => a.data.is_featured);
const patternALead = patternAArticles[0] || allArticles[1] || leadHero;
const patternAMinis = patternAArticles.slice(1, 5);

// 3. Pattern B (Artikel Terbaru) Segmentation
const patternBArticles = allArticles.filter((a) => !heroSetIds.has(a.id) || a.id !== leadHero?.id);
const patternBLeads = patternBArticles.slice(0, 2);
const patternBSubgrid = patternBArticles.slice(2, 6);

// 4. Popular Articles Widget (Ranked 1-5)
const popularArticles = allArticles
	.filter((a) => a.data.is_popular)
	.sort((a, b) => (a.data.popular_rank || 99) - (b.data.popular_rank || 99))
	.slice(0, 5);
---

<Base title={siteTitle} description={siteTagline}>
	<div class="homepage-container">
		{/* 1. HERO BENTO 5-CARD SECTION */}
		{leadHero && (
			<section class="hero-bento-section" aria-label="Kajian Utama & Pilihan Editorial">
				<div class="hero-bento-grid">
					{/* Left ~57% Major Curated Lead Story */}
					<article class="hero-lead-card">
						<a href={`/${leadHero.id}`} class="hero-lead-image-link" aria-label={leadHero.data.title}>
							<div class="hero-image-wrapper">
								{leadHero.data.featured_image ? (
									<Image image={leadHero.data.featured_image} />
								) : (
									<div class="hero-fallback-cover">
										<span>AFAQ TAFSIR</span>
									</div>
								)}
							</div>
						</a>
						<div class="hero-lead-content">
							<a href={`/kategori/${getArticleCategory(leadHero.data.id).slug}`} class="badge-category">
								{getArticleCategory(leadHero.data.id).label}
							</a>
							<h1 class="hero-lead-title">
								<a href={`/${leadHero.id}`}>{leadHero.data.title}</a>
							</h1>
							<p class="hero-lead-excerpt">{leadHero.data.excerpt}</p>
							<div class="card-meta">
								<span class="meta-author">
									{leadHero.data.bylines?.[0]?.byline?.displayName || "Mochamad Refian Prasetyo, S.Ag."}
								</span>
								<span class="meta-sep">•</span>
								<time class="meta-date">{formatDate(leadHero.data.publishedAt)}</time>
								<span class="meta-sep">•</span>
								<span class="meta-reading-time">⏱ {leadHero.data.reading_time || "7 mnt baca"}</span>
							</div>
						</div>
					</article>

					{/* Right ~43% 4 Stacked Secondary Cards */}
					<div class="hero-secondary-stack">
						{secondaryHeroes.map((item) => (
							<article class="hero-secondary-card">
								<a href={`/${item.id}`} class="secondary-thumb-link" aria-label={item.data.title}>
									<div class="secondary-thumb-wrapper">
										{item.data.featured_image ? (
											<Image image={item.data.featured_image} />
										) : (
											<div class="secondary-thumb-fallback">
												<span>TAFSIR</span>
											</div>
										)}
									</div>
								</a>
								<div class="secondary-card-body">
									<a href={`/kategori/${getArticleCategory(item.data.id).slug}`} class="badge-category-mini">
										{getArticleCategory(item.data.id).label}
									</a>
									<h2 class="secondary-card-title">
										<a href={`/${item.id}`}>{item.data.title}</a>
									</h2>
									<div class="card-meta-mini">
										<span class="meta-author">
											{item.data.bylines?.[0]?.byline?.displayName || "Redaksi"}
										</span>
										<span class="meta-sep">•</span>
										<span class="meta-time">{item.data.reading_time || "5 mnt"}</span>
									</div>
								</div>
							</article>
						))}
					</div>
				</div>
			</section>
		)}

		{/* 2. MODULAR R2 VIDEO SHOWCASE BOX */}
		<section class="video-showcase-section" id="kajian-pilihan" aria-label="Kajian Visual & Multimedia">
			<div class="video-showcase-box">
				<div class="video-player-container">
					<video
						controls
						playsinline
						preload="metadata"
						poster="https://images.unsplash.com/photo-1506703719100-a0f3a48c0f86?w=1200&h=675&fit=crop"
						class="native-video-player"
					>
						<source src="https://assets.afaqtafsir.id/videos/kajian-kosmologi-qurani.mp4" type="video/mp4" />
						Browser Anda tidak mendukung pemutar video HTML5.
					</video>
				</div>
				<div class="video-info-container">
					<h2 class="video-title">Kosmologi Al-Qur'an dan Dimensi Penciptaan Alam Semesta</h2>
					<div class="video-speaker-byline">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
							<path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
							<line x1="12" y1="19" x2="12" y2="22"></line>
						</svg>
						<span>Dr. Hamdan Syukri, M.Ud. & Tim Redaksi Afaq Tafsir</span>
					</div>
					<p class="video-synopsis">
						Menelaah perjumpaan metodologis antara teks wahyu Al-Qur'an dan fisika modern mengenai asal-usul singularitas kosmos dalam perspektif tafsir tematik saintifik.
					</p>
					<a href="/kosmologi-big-bang-dan-konsep-ratqan-fataqnah" class="btn-video-read">
						<span>Baca Ringkasan Kajian Ilmiah →</span>
					</a>
				</div>
			</div>
		</section>

		{/* 3. MAIN CONTENT FEED & SIDEBAR GRID */}
		<div class="main-layout-grid">
			{/* LEFT COLUMN: 70% Content Feeds */}
			<div class="content-feed-column">
				
				{/* 3.1 ARTIKEL PILIHAN (Layout Pattern A) */}
				<section class="section-block" aria-label="Artikel Pilihan">
					<div class="section-header">
						<h2 class="section-title">Artikel Pilihan</h2>
						<span class="amber-bar"></span>
					</div>
					
					<div class="pattern-a-grid">
						{/* Pattern A Left: 50% Large Lead */}
						{patternALead && (
							<article class="pattern-a-lead">
								<a href={`/${patternALead.id}`} class="pattern-lead-img-link">
									<div class="pattern-lead-img">
										{patternALead.data.featured_image ? (
											<Image image={patternALead.data.featured_image} />
										) : (
											<div class="pattern-lead-fallback">AFAQ TAFSIR</div>
										)}
									</div>
								</a>
								<div class="pattern-lead-body">
									<a href={`/kategori/${getArticleCategory(patternALead.data.id).slug}`} class="badge-category">
										{getArticleCategory(patternALead.data.id).label}
									</a>
									<h3 class="pattern-lead-title">
										<a href={`/${patternALead.id}`}>{patternALead.data.title}</a>
									</h3>
									<p class="pattern-lead-excerpt">{patternALead.data.excerpt}</p>
									<div class="card-meta">
										<span class="meta-author">{patternALead.data.bylines?.[0]?.byline?.displayName || "Redaksi"}</span>
										<span class="meta-sep">•</span>
										<time class="meta-date">{formatDate(patternALead.data.publishedAt)}</time>
									</div>
								</div>
							</article>
						)}

						{/* Pattern A Right: 50% Mini 4-Stack */}
						<div class="pattern-a-mini-stack">
							{patternAMinis.map((item) => (
								<article class="pattern-a-mini-item">
									<a href={`/${item.id}`} class="mini-item-thumb-link">
										<div class="mini-item-thumb">
											{item.data.featured_image ? (
												<Image image={item.data.featured_image} />
											) : (
												<div class="mini-thumb-fallback">TAFSIR</div>
											)}
										</div>
									</a>
									<div class="mini-item-body">
										<a href={`/kategori/${getArticleCategory(item.data.id).slug}`} class="badge-category-mini">
											{getArticleCategory(item.data.id).label}
										</a>
										<h4 class="mini-item-title">
											<a href={`/${item.id}`}>{item.data.title}</a>
										</h4>
										<time class="mini-item-date">{formatDate(item.data.publishedAt)}</time>
									</div>
								</article>
							))}
						</div>
					</div>
				</section>

				{/* 3.2 ARTIKEL TERBARU (Layout Pattern B) */}
				<section class="section-block" aria-label="Artikel Terbaru">
					<div class="section-header">
						<h2 class="section-title">Artikel Terbaru</h2>
						<span class="amber-bar"></span>
					</div>

					{/* Top Half: 2 Medium Featured Cards */}
					<div class="pattern-b-leads-grid">
						{patternBLeads.map((item) => (
							<article class="pattern-b-card">
								<a href={`/${item.id}`} class="pattern-b-img-link">
									<div class="pattern-b-img">
										{item.data.featured_image ? (
											<Image image={item.data.featured_image} />
										) : (
											<div class="pattern-b-fallback">AFAQ</div>
										)}
									</div>
								</a>
								<div class="pattern-b-body">
									<a href={`/kategori/${getArticleCategory(item.data.id).slug}`} class="badge-category">
										{getArticleCategory(item.data.id).label}
									</a>
									<h3 class="pattern-b-title">
										<a href={`/${item.id}`}>{item.data.title}</a>
									</h3>
									<p class="pattern-b-excerpt">{item.data.excerpt}</p>
									<div class="card-meta">
										<span class="meta-author">{item.data.bylines?.[0]?.byline?.displayName || "Redaksi"}</span>
										<span class="meta-sep">•</span>
										<time class="meta-date">{formatDate(item.data.publishedAt)}</time>
									</div>
								</div>
							</article>
						))}
					</div>

					{/* Bottom Half: 2x2 Subgrid of 4 Compact Items */}
					<div class="pattern-b-subgrid">
						{patternBSubgrid.map((item) => (
							<article class="subgrid-item">
								<a href={`/${item.id}`} class="subgrid-thumb-link">
									<div class="subgrid-thumb">
										{item.data.featured_image ? (
											<Image image={item.data.featured_image} />
										) : (
											<div class="subgrid-fallback">📖</div>
										)}
									</div>
								</a>
								<div class="subgrid-body">
									<h4 class="subgrid-title">
										<a href={`/${item.id}`}>{item.data.title}</a>
									</h4>
									<div class="subgrid-meta">
										<time>{formatDate(item.data.publishedAt)}</time>
									</div>
								</div>
							</article>
						))}
					</div>
				</section>
			</div>

			{/* RIGHT COLUMN: ~30% (340px) Editorial Sidebar */}
			<aside class="sidebar-column">
				
				{/* WIDGET 1: TENTANG AFAQ TAFSIR */}
				<div class="sidebar-widget widget-about">
					<div class="widget-header">
						<h3 class="widget-title">Tentang Afaq Tafsir</h3>
						<span class="amber-bar"></span>
					</div>
					<p class="widget-about-text">
						Afaq Tafsir diinisiasi pada tahun 2026 oleh mahasiswi <strong>Pendidikan Kader Ulama Masjid Istiqlal (PKUMI) — Program Kader Ulama Perempuan</strong> untuk menghadirkan ruang ilmiah kajian tafsir dan pemikiran Qur'ani.
					</p>
					<a href="/tentang" class="widget-link-arrow">
						<span>Baca Manifesto & Visi Kami →</span>
					</a>
				</div>

				{/* WIDGET 2: ARTIKEL TERBANYAK DIBACA (Ranked 01-05) */}
				<div class="sidebar-widget widget-popular">
					<div class="widget-header">
						<h3 class="widget-title">Artikel Terpopuler</h3>
						<span class="amber-bar"></span>
					</div>
					<div class="popular-list">
						{popularArticles.map((item, index) => (
							<article class="popular-item">
								<span class="popular-rank">0{index + 1}</span>
								<div class="popular-body">
									<h4 class="popular-title">
										<a href={`/${item.id}`}>{item.data.title}</a>
									</h4>
									<div class="popular-meta">
										<span class="popular-reads-metric">🔥 {item.data.popular_reads || "12.4k dibaca"}</span>
									</div>
								</div>
							</article>
						))}
					</div>
				</div>

				{/* WIDGET 3: CTA PANGGILAN KONTRIBUTOR */}
				<div class="sidebar-widget widget-contributor-cta">
					<h3 class="contributor-title">Kirimkan Naskah Esai & Kajian Tafsir Anda</h3>
					<p class="contributor-desc">
						Redaksi Afaq Tafsir membuka penerimaan artikel tematik tafsir, manuskrip, dan pemikiran Islam untuk dipublikasikan secara berkala.
					</p>
					<a href="/kirim-tulisan" class="btn-contributor-full">
						<span>Panduan Pengiriman Naskah →</span>
					</a>
				</div>

			</aside>
		</div>
	</div>
</Base>

<style>
	.homepage-container {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-6) var(--spacing-6) var(--spacing-16);
	}

	/* ==========================================================================
	   1. HERO BENTO SECTION
	   ========================================================================== */
	.hero-bento-section {
		margin-bottom: var(--spacing-12);
	}

	.hero-bento-grid {
		display: grid;
		grid-template-columns: 58% 42%;
		gap: var(--spacing-8);
		align-items: stretch;
	}

	/* Hero Lead Card (Left ~58%) */
	.hero-lead-card {
		display: flex;
		flex-direction: column;
		background: var(--white);
		border: 1px solid var(--sky-200);
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		transition: transform var(--transition-fast), box-shadow var(--transition-fast);
	}

	:global(.dark) .hero-lead-card {
		background: var(--blue-950);
		border-color: rgba(52, 198, 244, 0.2);
	}

	.hero-lead-card:hover {
		box-shadow: var(--shadow-md);
		transform: translateY(-2px);
	}

	.hero-lead-image-link {
		display: block;
		overflow: hidden;
	}

	.hero-image-wrapper {
		aspect-ratio: 16 / 9;
		width: 100%;
		overflow: hidden;
		background: var(--sky-100);
	}

	.hero-image-wrapper :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.hero-lead-card:hover .hero-image-wrapper :global(img) {
		transform: scale(1.03);
	}

	.hero-fallback-cover {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--bg-dark-section);
		color: var(--sky-300);
		font-family: var(--font-serif);
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	.hero-lead-content {
		padding: var(--spacing-6);
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.hero-lead-title {
		font-size: 1.65rem;
		line-height: 1.25;
		margin-bottom: var(--spacing-3);
	}

	.hero-lead-title a {
		color: var(--blue-950);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	:global(.dark) .hero-lead-title a {
		color: var(--white);
	}

	.hero-lead-title a:hover {
		color: var(--text-brand);
	}

	.hero-lead-excerpt {
		font-size: 0.95rem;
		line-height: 1.65;
		color: var(--slate-700);
		margin-bottom: var(--spacing-5);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	:global(.dark) .hero-lead-excerpt {
		color: var(--slate-300);
	}

	.card-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 6px;
		font-size: 0.82rem;
		color: var(--slate-600);
		margin-top: auto;
	}

	:global(.dark) .card-meta {
		color: var(--slate-400);
	}

	.meta-author {
		font-weight: 600;
		color: var(--slate-800);
	}

	:global(.dark) .meta-author {
		color: var(--slate-200);
	}

	.meta-sep {
		opacity: 0.5;
	}

	/* Hero Secondary Stack (Right ~42%) */
	.hero-secondary-stack {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
	}

	.hero-secondary-card {
		display: flex;
		align-items: center;
		gap: var(--spacing-4);
		padding: var(--spacing-3);
		background: var(--white);
		border: 1px solid var(--sky-200);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-sm);
		transition: transform var(--transition-fast), border-color var(--transition-fast);
	}

	:global(.dark) .hero-secondary-card {
		background: var(--blue-950);
		border-color: rgba(52, 198, 244, 0.15);
	}

	.hero-secondary-card:hover {
		transform: translateX(3px);
		border-color: var(--sky-400);
	}

	.secondary-thumb-link {
		flex-shrink: 0;
	}

	.secondary-thumb-wrapper {
		width: 100px;
		height: 100px;
		border-radius: var(--radius-sm);
		overflow: hidden;
		background: var(--sky-100);
	}

	.secondary-thumb-wrapper :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.secondary-thumb-fallback {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--blue-900);
		color: var(--sky-300);
		font-size: 0.7rem;
		font-weight: 700;
	}

	.secondary-card-body {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.secondary-card-title {
		font-size: 0.98rem;
		line-height: 1.35;
		margin-bottom: 6px;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.secondary-card-title a {
		color: var(--blue-950);
		text-decoration: none;
	}

	:global(.dark) .secondary-card-title a {
		color: var(--white);
	}

	.secondary-card-title a:hover {
		color: var(--text-brand);
	}

	.card-meta-mini {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 0.78rem;
		color: var(--slate-600);
	}

	:global(.dark) .card-meta-mini {
		color: var(--slate-400);
	}

	/* ==========================================================================
	   2. MODULAR R2 VIDEO SHOWCASE BOX
	   ========================================================================== */
	.video-showcase-section {
		margin-bottom: var(--spacing-16);
	}

	.video-showcase-box {
		display: grid;
		grid-template-columns: 55% 45%;
		background: linear-gradient(135deg, var(--blue-900) 0%, var(--blue-950) 100%);
		border: 1px solid rgba(52, 198, 244, 0.25);
		border-radius: var(--radius-lg);
		padding: var(--spacing-8);
		gap: var(--spacing-8);
		align-items: center;
		box-shadow: var(--shadow-lg);
		color: var(--white);
	}

	.video-player-container {
		position: relative;
		border-radius: var(--radius-md);
		overflow: hidden;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
		aspect-ratio: 16 / 9;
		background: #000;
	}

	.native-video-player {
		width: 100%;
		height: 100%;
