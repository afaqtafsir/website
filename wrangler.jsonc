{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "website",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "afaqtafsir-website","database_id": "d78c46b7-3657-4108-babb-80ad6d9c04d9",
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "afaqtafsir-website","preview_bucket_name": "afaqtafsir-website",
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "8212949e681f4832b302e384af46274c"
		}
	],
	// Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
	"triggers": {
		"crons": ["* * * * *"],
	},
}
