			:global(.dark) :global(.site-search-result) {
				color: var(--slate-200);
				border-color: rgba(255, 255, 255, 0.08);
			}

			:global(.site-search-result):hover,
			:global(.site-search-result.focused) {
				background: var(--sky-50);
			}

			:global(.dark) :global(.site-search-result):hover,
			:global(.dark) :global(.site-search-result.focused) {
				background: var(--blue-900);
			}

			main {
				min-height: calc(100vh - 400px);
			}

			/* Footer */
			.site-footer {
				background: linear-gradient(180deg, var(--blue-900) 0%, var(--blue-950) 100%);
				color: var(--sky-100);
				border-top: 1px solid rgba(52, 198, 244, 0.2);
				margin-top: var(--spacing-16);
			}

			.footer-inner {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-16) var(--spacing-6) var(--spacing-8);
			}

			.footer-grid {
				display: grid;
				grid-template-columns: 2fr 1fr 1.2fr 1fr;
				gap: var(--spacing-10);
