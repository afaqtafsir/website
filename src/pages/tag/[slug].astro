---
import {
	getTerm,
	getEmDashCollection,
	getTermsForEntries,
	decodeSlug,
} from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);
const term = slug ? await getTerm("tag", slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const { entries: articles, cacheHint } = await getEmDashCollection("articles", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tagIds = articles.map((p) => p.data.id);
const tagsByEntry = await getTermsForEntries("articles", tagIds, "tag");

function formatIndonesianDate(date: Date | string | null | undefined) {
	if (!date) return "18 Agustus 2026";
	const d = typeof date === "string" ? new Date(date) : date;
	return d.toLocaleDateString("id-ID", {
		day: "numeric",
		month: "long",
		year: "numeric",
	});
}
---

<Base
	title={`Kajian Terkait Tag: #${term.label}`}
	description={`Semua artikel dan kajian tafsir dengan topik #${term.label} di Afaq Tafsir.`}
>
	<section class="archive-section">
		<header class="archive-header">
			<div class="archive-badge-wrap">
				<span class="badge-gold">TOPIK / TAG</span>
			</div>
			<h1 class="archive-title">#{term.label}</h1>
			<p class="archive-count">
				Menampilkan {articles.length} artikel kajian
			</p>
			<span class="amber-bar"></span>
		</header>

		{
			articles.length === 0 ? (
				<p class="no-posts">Belum ada artikel dengan tag ini.</p>
			) : (
				<div class="archive-grid">
					{articles.map((article) => {
						const tags = tagsByEntry.get(article.data.id) ?? [];
						const authorName = article.data.byline?.displayName || article.data.bylines?.[0]?.byline?.displayName || "Redaksi";
						return (
							<article class="archive-card">
								<a href={`/${article.id}`} class="card-img-link">
									<div class="card-img-wrapper">
										{article.data.featured_image ? (
											<Image image={article.data.featured_image} />
										) : (
											<div class="card-fallback">AFAQ TAFSIR</div>
										)}
									</div>
								</a>
								<div class="card-body">
									<div class="card-tags-row">
										{tags.slice(0, 2).map((t) => (
											<span class="tag-mini">#{t.label}</span>
										))}
									</div>
									<h2 class="card-title">
										<a href={`/${article.id}`}>{article.data.title}</a>
									</h2>
									<p class="card-excerpt">{article.data.excerpt}</p>
									<div class="card-meta">
										<span class="meta-author">{authorName}</span>
										<span class="meta-sep">•</span>
										<time class="meta-date">{formatIndonesianDate(article.data.published_at)}</time>
									</div>
								</div>
							</article>
						);
					})}
				</div>
			)
		}
	</section>
</Base>

<style>
	.archive-section {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-10) var(--spacing-6) var(--spacing-16);
	}

	.archive-header {
		margin-bottom: var(--spacing-10);
	}

	.archive-badge-wrap {
		margin-bottom: var(--spacing-3);
	}

	.archive-title {
		font-size: 2.4rem;
		color: var(--blue-950);
		margin: 0 0 var(--spacing-2);
	}

	:global(.dark) .archive-title {
		color: var(--white);
	}

	.archive-count {
		font-size: 0.95rem;
		color: var(--slate-600);
		margin: 0;
	}

	:global(.dark) .archive-count {
		color: var(--slate-400);
	}

	.archive-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-8);
	}

	.archive-card {
		background: var(--white);
		border: 1px solid var(--sky-200);
		border-radius: var(--radius-md);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		box-shadow: var(--shadow-sm);
		transition: transform var(--transition-fast), box-shadow var(--transition-fast);
	}

	:global(.dark) .archive-card {
		background: var(--blue-950);
		border-color: rgba(52, 198, 244, 0.2);
	}

	.archive-card:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}

	.card-img-link {
		display: block;
		aspect-ratio: 16 / 10;
		overflow: hidden;
	}

	.card-img-wrapper {
		width: 100%;
		height: 100%;
	}

	.card-img-wrapper :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.card-fallback {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--blue-900);
		color: var(--sky-300);
		font-weight: 700;
		font-size: 0.85rem;
	}

	.card-body {
		padding: var(--spacing-5);
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.card-tags-row {
		display: flex;
		gap: 6px;
		margin-bottom: var(--spacing-2);
	}

	.tag-mini {
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--text-brand);
	}

	.card-title {
		font-size: 1.18rem;
		line-height: 1.35;
		margin: 0 0 var(--spacing-2);
	}

	.card-title a {
		color: var(--blue-950);
		text-decoration: none;
	}

	:global(.dark) .card-title a {
		color: var(--white);
	}

	.card-title a:hover {
		color: var(--text-brand);
	}

	.card-excerpt {
		font-size: 0.88rem;
		line-height: 1.6;
		color: var(--slate-700);
		margin-bottom: var(--spacing-4);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	:global(.dark) .card-excerpt {
		color: var(--slate-300);
	}

	.card-meta {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 0.8rem;
		color: var(--slate-600);
		margin-top: auto;
	}

	.meta-author {
		font-weight: 600;
		color: var(--slate-800);
	}

	:global(.dark) .meta-author {
		color: var(--slate-200);
	}

	.meta-sep {
		opacity: 0.5;
	}

	.no-posts {
		color: var(--slate-600);
		font-size: 1rem;
		padding: var(--spacing-8) 0;
	}

	@media (max-width: 900px) {
		.archive-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.archive-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
