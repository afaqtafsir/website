---
import {
	getEmDashCollection,
	getSiteSettings,
} from "emdash";
import Base from "../../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

const [{ entries: articles, cacheHint }, siteSettings] = await Promise.all([
	getEmDashCollection("articles", {
		status: "published",
		limit: 100,
	}),
	getSiteSettings(),
]);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle } = resolveBlogSiteIdentity(siteSettings);

// Aggregate unique bylines with article counts
interface AuthorAggregate {
	id: string;
	slug: string;
	displayName: string;
	bio: string | null;
	avatarMediaId: string | null;
	avatarStorageKey?: string | null;
	isGuest: boolean;
	articleCount: number;
}

const bylineMap = new Map<string, AuthorAggregate>();

for (const article of articles) {
	for (const credit of article.data.bylines ?? []) {
		const { byline } = credit;
		if (!byline) continue;

		if (!bylineMap.has(byline.id)) {
			bylineMap.set(byline.id, {
				id: byline.id,
				slug: byline.slug,
				displayName: byline.displayName,
				bio: byline.bio ?? null,
				avatarMediaId: byline.avatarMediaId ?? null,
				avatarStorageKey: byline.avatarStorageKey ?? null,
				isGuest: byline.isGuest,
				articleCount: 0,
			});
		}
		const author = bylineMap.get(byline.id)!;
		author.articleCount += 1;
	}
}

const authors = Array.from(bylineMap.values()).sort((a, b) => {
	if (b.articleCount !== a.articleCount) {
		return b.articleCount - a.articleCount;
	}
	return a.displayName.localeCompare(b.displayName);
});

// Helper for initials
function getInitials(name: string) {
	const parts = name
		.replace(/^(Dr\.|Prof\.|K\.H\.|Ustadz|Ustadzah)\s+/gi, "")
		.replace(/,\s*[A-Za-z\.]+/g, "")
		.trim()
		.split(/\s+/);
	if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
	return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}
---

<Base
	title={`Direktori Penulis & Kontributor — ${siteTitle}`}
	description="Direktori akademisi, peneliti, dan pemikir yang berkontribusi dalam kajian tafsir dan studi Al-Qur'an di Afaq Tafsir."
>
	<div class="authors-page-container">
		{/* BREADCRUMB */}
		<nav class="breadcrumb-nav" aria-label="Breadcrumb">
			<ol class="breadcrumb-list">
				<li><a href="/">Beranda</a></li>
				<li class="breadcrumb-sep">›</li>
				<li class="breadcrumb-active" aria-current="page">Direktori Penulis</li>
			</ol>
		</nav>

		{/* HEADER */}
		<header class="authors-header">
			<span class="header-badge">DIREKTORI KONTRIBUTOR</span>
			<h1 class="authors-title">Penulis & Kontributor</h1>
			<span class="amber-bar"></span>
			<p class="authors-lead">
				Mengenal para akademisi, peneliti, santri, dan pemikir yang berkontribusi dalam menghadirkan kajian tafsir Al-Qur'an yang kritis, kontekstual, dan berintegritas di <strong>afaqtafsir.id</strong>.
			</p>
		</header>

		{/* AUTHORS DIRECTORY GRID */}
		{authors.length === 0 ? (
			<div class="empty-state-card">
				<p>Belum ada profil penulis yang terdaftar.</p>
			</div>
		) : (
			<section class="authors-grid" aria-label="Daftar Penulis">
				{authors.map((author) => (
					<article class="author-card">
						<div class="card-top-row">
							<div class="author-avatar-wrap">
								{author.avatarStorageKey || author.avatarMediaId ? (
									<img
										src={`/_emdash/api/media/file/${author.avatarStorageKey || author.avatarMediaId}`}
										alt={author.displayName}
										class="author-avatar-img"
									/>
								) : (
									<div class="author-avatar-fallback">
										{getInitials(author.displayName)}
									</div>
								)}
							</div>
							<div class="author-badge-wrap">
								<span class="role-badge">
									{author.isGuest ? "Kontributor Tamu" : "Penulis / Peneliti"}
								</span>
							</div>
						</div>

						<div class="card-info">
							<h2 class="author-name">
								<a href={`/penulis/${author.slug}`}>{author.displayName}</a>
							</h2>
							<p class="author-bio">
								{author.bio || "Penulis dan kontributor kajian Al-Qur'an dan tafsir di Afaq Tafsir."}
							</p>
						</div>

						<div class="card-footer">
							<div class="count-pill">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
									<path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
								</svg>
								<span>{author.articleCount} Kajian</span>
							</div>

							<a href={`/penulis/${author.slug}`} class="profile-link" aria-label={`Lihat profil dan kajian ${author.displayName}`}>
								<span>Lihat Profil →</span>
							</a>
						</div>
					</article>
				))}
			</section>
		)}

		{/* CALL TO ACTION BANNER */}
		<section class="cta-contributor-section" aria-label="Ajakan Menulis">
			<div class="cta-card">
				<div class="cta-content">
					<span class="cta-badge">PANGGILAN KONTRIBUTOR</span>
					<h2 class="cta-title">Tertarik Mempublikasikan Kajian Anda?</h2>
					<p class="cta-desc">
						Afaq Tafsir membuka ruang bagi akademisi, santri, dan pemikir Islam untuk berbagi riset, pembacaan kritis, dan artikel tafsir tematik.
					</p>
				</div>
				<div class="cta-action">
					<a href="/kirim-tulisan" class="cta-button">
						<span>Panduan Pengiriman Naskah →</span>
					</a>
				</div>
			</div>
		</section>
	</div>
</Base>

<style>
	.authors-page-container {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-6) var(--spacing-6) var(--spacing-16);
	}

	/* Breadcrumb */
	.breadcrumb-nav {
		margin-bottom: var(--spacing-6);
	}

	.breadcrumb-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--spacing-2);
		font-size: 0.85rem;
		color: var(--slate-600);
	}

	.breadcrumb-list a {
		color: var(--slate-600);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.breadcrumb-list a:hover {
		color: var(--text-brand);
		text-decoration: underline;
	}

	:global(.dark) .breadcrumb-list a {
		color: var(--slate-400);
	}

	.breadcrumb-sep {
		opacity: 0.4;
	}

	.breadcrumb-active {
		color: var(--blue-950);
		font-weight: 600;
	}

	:global(.dark) .breadcrumb-active {
		color: var(--sky-300);
	}

	/* Header */
	.authors-header {
		margin-bottom: var(--spacing-10);
	}

	.header-badge {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-brand);
		margin-bottom: var(--spacing-2);
	}

	:global(.dark) .header-badge {
		color: var(--sky-400);
	}

	.authors-title {
		font-size: 2.4rem;
		color: var(--blue-950);
		margin: 0 0 var(--spacing-2);
	}

	:global(.dark) .authors-title {
		color: var(--white);
	}

	.authors-lead {
		font-size: 1.12rem;
		line-height: 1.7;
		color: var(--slate-700);
		max-width: 820px;
		margin: 0;
	}

	:global(.dark) .authors-lead {
		color: var(--slate-300);
	}

	/* Grid of Author Cards */
	.authors-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-8);
		margin-bottom: var(--spacing-16);
	}

	.author-card {
		background: var(--white);
		border: 1px solid var(--sky-200);
		border-radius: var(--radius-lg);
		padding: var(--spacing-6);
		display: flex;
		flex-direction: column;
		box-shadow: var(--shadow-sm);
		transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
	}

	:global(.dark) .author-card {
		background: var(--blue-950);
		border-color: rgba(52, 198, 244, 0.2);
	}

	.author-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
		border-color: var(--sky-400);
	}

	.card-top-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: var(--spacing-4);
	}

	.author-avatar-wrap {
		flex-shrink: 0;
	}

	.author-avatar-img {
		width: 72px;
		height: 72px;
		border-radius: 50%;
		object-fit: cover;
		border: 2px solid var(--sky-200);
	}

	.author-avatar-fallback {
		width: 72px;
		height: 72px;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--blue-900) 0%, var(--blue-800) 100%);
		border: 2px solid var(--sky-300);
		color: var(--sky-100);
		font-family: var(--font-serif);
		font-size: 1.55rem;
		font-weight: 700;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.role-badge {
		font-size: 0.68rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		background: var(--gold-100);
		color: var(--gold-600);
		padding: 3px 8px;
		border-radius: var(--radius-full);
		border: 1px solid rgba(217, 119, 6, 0.25);
	}

	:global(.dark) .role-badge {
		background: rgba(217, 119, 6, 0.2);
		color: var(--gold-400);
		border-color: rgba(245, 158, 11, 0.3);
	}

	.card-info {
		flex-grow: 1;
		margin-bottom: var(--spacing-5);
	}

	.author-name {
		font-size: 1.25rem;
		line-height: 1.3;
		margin: 0 0 var(--spacing-2);
	}

	.author-name a {
		color: var(--blue-950);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	:global(.dark) .author-name a {
		color: var(--white);
	}

	.author-name a:hover {
		color: var(--text-brand);
	}

	:global(.dark) .author-name a:hover {
		color: var(--sky-400);
	}

	.author-bio {
		font-size: 0.88rem;
		line-height: 1.6;
		color: var(--slate-700);
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	:global(.dark) .author-bio {
		color: var(--slate-300);
	}

	.card-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: var(--spacing-4);
		border-top: 1px solid var(--slate-100);
	}

	:global(.dark) .card-footer {
		border-top-color: rgba(255, 255, 255, 0.08);
	}

	.count-pill {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--slate-600);
	}

	:global(.dark) .count-pill {
		color: var(--slate-400);
	}

	.profile-link {
		font-size: 0.84rem;
		font-weight: 700;
		color: var(--text-brand);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.profile-link:hover {
		color: var(--blue-900);
		text-decoration: underline;
	}

	:global(.dark) .profile-link {
		color: var(--sky-400);
	}

	:global(.dark) .profile-link:hover {
		color: var(--sky-300);
	}

	/* Contributor CTA */
	.cta-contributor-section {
		margin-top: var(--spacing-6);
	}

	.cta-card {
		background: linear-gradient(135deg, var(--blue-900) 0%, var(--blue-950) 100%);
		border: 1px solid var(--sky-300);
		border-radius: var(--radius-lg);
		padding: var(--spacing-8) var(--spacing-10);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-8);
		color: var(--white);
		box-shadow: var(--shadow-md);
	}

	.cta-badge {
		display: inline-block;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--gold-400);
		margin-bottom: var(--spacing-2);
	}

	.cta-title {
		font-size: 1.6rem;
		color: var(--white);
		margin: 0 0 var(--spacing-2);
	}

	.cta-desc {
		font-size: 0.95rem;
		line-height: 1.65;
		color: var(--sky-100);
		max-width: 620px;
		margin: 0;
	}

	.cta-action {
		flex-shrink: 0;
	}

	.cta-button {
		display: inline-block;
		background: var(--gold-500);
		color: var(--white);
		font-weight: 700;
		font-size: 0.92rem;
		padding: 12px 24px;
		border-radius: var(--radius-full);
		text-decoration: none;
		box-shadow: 0 4px 12px rgba(217, 119, 6, 0.3);
		transition: background var(--transition-fast), transform var(--transition-fast);
	}

	.cta-button:hover {
		background: var(--gold-600);
		transform: translateY(-2px);
	}

	.empty-state-card {
		padding: var(--spacing-12);
		text-align: center;
		color: var(--slate-600);
	}

	@media (max-width: 960px) {
		.authors-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.cta-card {
			flex-direction: column;
			align-items: flex-start;
			padding: var(--spacing-6);
		}

		.cta-action {
			width: 100%;
		}

		.cta-button {
			display: block;
			text-align: center;
		}
	}

	@media (max-width: 640px) {
		.authors-grid {
			grid-template-columns: 1fr;
		}

		.authors-title {
			font-size: 1.85rem;
		}
	}
</style>
