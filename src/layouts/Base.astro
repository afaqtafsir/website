			.footer-logo {
				display: flex;
				align-items: center;
				gap: 10px;
				text-decoration: none;
				margin-bottom: var(--spacing-3);
			}

			.footer-logo-img {
				width: 34px;
				height: auto;
				object-fit: contain;
				flex-shrink: 0;
			}

			.footer-brand-title {
				font-family: var(--font-serif);
				font-size: 1.35rem;
				font-weight: 700;
				color: var(--white);
				letter-spacing: -0.01em;
			}

			.footer-tagline {
				font-size: 0.95rem;
				font-weight: 600;
				color: var(--sky-300);
				margin-bottom: var(--spacing-2);
			}

			.footer-subtext {
				font-size: 0.82rem;
				line-height: 1.6;
				color: var(--sky-200);
				opacity: 0.85;
				margin-bottom: var(--spacing-4);
			}

			.footer-social-icons {
				display: flex;
				gap: 10px;
			}

			.social-icon-btn {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 34px;
				height: 34px;
				background: rgba(255, 255, 255, 0.08);
				border: 1px solid rgba(52, 198, 244, 0.3);
				border-radius: var(--radius-full);
				color: var(--sky-200);
				transition: all var(--transition-fast);
			}

			.social-icon-btn:hover {
				background: var(--sky-500);
				color: var(--blue-950);
				transform: translateY(-2px);
				border-color: var(--sky-400);
			}

			.footer-heading {
				font-family: var(--font-serif);
				font-size: 0.95rem;
				font-weight: 600;
				color: var(--white);
				margin-bottom: var(--spacing-4);
				letter-spacing: 0.01em;
			}

			.footer-links {
				list-style: none;
			}

			.footer-links li {
				margin-bottom: 9px;
			}

			.footer-links a {
				color: var(--sky-100);
				opacity: 0.85;
				text-decoration: none;
				font-size: 0.88rem;
				transition: opacity var(--transition-fast), color var(--transition-fast);
			}

			.footer-links a:hover {
				opacity: 1;
				color: var(--sky-400);
				padding-left: 2px;
			}

			.footer-bottom {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding-top: var(--spacing-6);
				border-top: 1px solid rgba(255, 255, 255, 0.1);
			}

			.footer-copyright {
				font-size: 0.82rem;
				color: var(--sky-200);
				opacity: 0.8;
			}

			.footer-copyright strong {
				color: var(--white);
			}

			/* Theme switcher */
			.theme-switcher {
				display: flex;
				gap: var(--spacing-1);
				padding: 3px;
				background: rgba(255, 255, 255, 0.1);
				border: 1px solid rgba(255, 255, 255, 0.15);
				border-radius: var(--radius-full);
			}

			.theme-btn {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 30px;
				height: 26px;
				background: transparent;
				border: none;
				color: var(--sky-200);
				border-radius: var(--radius-full);
				cursor: pointer;
				transition: all var(--transition-fast);
			}

			.theme-btn:hover {
				color: var(--white);
			}

			.theme-btn.active {
				background: var(--sky-500);
				color: var(--blue-950);
			}

			@media (max-width: 960px) {
				.footer-grid {
					grid-template-columns: 1fr 1fr;
					gap: var(--spacing-8);
				}

				.footer-brand {
					grid-column: span 2;
					max-width: none;
				}
			}

			@media (max-width: 768px) {
				.nav {
					flex-wrap: wrap;
					padding: var(--spacing-3) var(--spacing-4);
				}

				.nav-center {
					order: 3;
					width: 100%;
					justify-content: center;
					padding-top: var(--spacing-2);
					border-top: 1px solid var(--sky-100);
				}

				.site-search {
					width: 140px;
				}

				.btn-cta-submit span {
					display: none;
				}

				.btn-cta-submit {
					padding: 7px 10px;
				}

				.footer-grid {
					grid-template-columns: 1fr;
				}

				.footer-brand {
					grid-column: span 1;
				}

				.footer-bottom {
					flex-direction: column;
					gap: var(--spacing-4);
					text-align: center;
				}
			}
		</style>

		<script>
			// ⌘K / Ctrl+K to focus search
			document.addEventListener("keydown", (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key === "k") {
					e.preventDefault();
					const searchInput = document.querySelector(
						".site-search-input"
					) as HTMLInputElement;
					if (searchInput) {
						searchInput.focus();
					}
				}
			});
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
