---
import { getMenu, getSiteSettings } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { Font } from "astro:assets";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(await getSiteSettings());
// If title already includes site title (from getSeoMeta), use as-is
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;

// Fetch primary menu defined in seed, with fallback items
const primaryMenu = await getMenu("primary");
const navItems: Array<{ label: string; url: string; target?: string | null }> = primaryMenu?.items?.length
	? primaryMenu.items.filter((item) => item.url !== "/kirim-tulisan")
	: [
			{ label: "Beranda", url: "/", target: undefined },
			{ label: "Penulis", url: "/penulis", target: undefined },
			{ label: "Tentang", url: "/tentang", target: undefined },
			{ label: "Kontak", url: "/kontak", target: undefined },
	  ];

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/logo.png" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<script is:inline define:vars={{
			pageType: type,
			articleTitle: title,
			authorName: author,
			publishedDate: publishedTime
		}}>
			window.dataLayer = window.dataLayer || [];
			window.dataLayer.push({
				page_type: pageType || 'website',
				article_title: articleTitle,
				author_name: authorName,
				published_date: publishedDate
			});
		</script>
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var c = document.cookie;
				var i = c.indexOf("theme=");
				var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class="site-header">
			<nav class="nav">
				<a href="/" class="brand-link" aria-label="Afaq Tafsir Home">
					<img src="/logo.png" alt="Afaq Tafsir Logo" class="brand-logo-img" width="38" height="36" />
					<div class="brand-text">
						<span class="brand-title">Afaq Tafsir</span>
						<span class="brand-subtitle">JURNAL & PEMIKIRAN QUR'ANI</span>
					</div>
				</a>

				<div class="nav-center">
					<div class="nav-links">
						{
							navItems.map((item) => (
								<a
									href={item.url}
									target={item.target}
									class={Astro.url.pathname === item.url ? "nav-link active" : "nav-link"}
								>
									{item.label}
								</a>
							))
						}
					</div>
				</div>

				<div class="nav-right">
					<LiveSearch
						placeholder="Cari kajian (⌘K)..."
						class="site-search"
						inputClass="site-search-input"
						resultsClass="site-search-results"
						resultClass="site-search-result"
						collections={["articles", "pages"]}
					/>
					
					<a href="/kirim-tulisan" class="btn-cta-submit">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 20h9"></path>
							<path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
						</svg>
						<span>Kirim Tulisan</span>
					</a>

					{
						isLoggedIn && (
							<a href="/_emdash/admin" class="nav-admin" title="Buka CMS Admin">
								Admin
							</a>
						)
					}
				</div>
			</nav>
		</header>

		<main id="main-content">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-grid">
					<!-- Column 1: Brand & Slogan -->
					<div class="footer-col footer-brand">
						<a href="/" class="footer-logo">
							<img src="/logo.png" alt="Afaq Tafsir Logo" class="footer-logo-img" width="34" height="32" />
							<span class="footer-brand-title">Afaq Tafsir</span>
						</a>
						<p class="footer-tagline">{siteTagline}</p>
						<p class="footer-subtext">Diinisiasi oleh Kader Ulama Perempuan PKUMI Masjid Istiqlal untuk mencerahkan pemikiran Qur'ani kontemporer.</p>
						
						<div class="footer-social-icons">
							<a href="https://instagram.com/afaqtafsir" target="_blank" rel="noopener" aria-label="Instagram" class="social-icon-btn">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
							</a>
							<a href="https://youtube.com/@afaqtafsir" target="_blank" rel="noopener" aria-label="YouTube" class="social-icon-btn">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
							</a>
							<a href="https://twitter.com/afaqtafsir" target="_blank" rel="noopener" aria-label="X (Twitter)" class="social-icon-btn">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z"></path><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path></svg>
							</a>
							<a href="/rss.xml" aria-label="RSS Feed" class="social-icon-btn">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
							</a>
						</div>
					</div>

					<!-- Column 2: Navigasi Utama -->
					<div class="footer-col footer-nav">
						<h4 class="footer-heading">Navigasi Utama</h4>
						<ul class="footer-links">
							<li><a href="/">Beranda Utama</a></li>
							<li><a href="/penulis">Direktori Penulis</a></li>
							<li><a href="/#kajian-pilihan">Kajian Pilihan Terkini</a></li>
							<li><a href="/kirim-tulisan">Pedoman Kirim Naskah</a></li>
							<li><a href="/tentang">Tentang Redaksi & Visi</a></li>
						</ul>
					</div>

					<!-- Column 3: Editorial & Kontak -->
					<div class="footer-col footer-nav">
						<h4 class="footer-heading">Editorial & Kerjasama</h4>
						<ul class="footer-links">
							<li><a href="mailto:afaqtafsir.id@gmail.com">afaqtafsir.id@gmail.com</a></li>
							<li><a href="/kontak">Hubungi Kerjasama & Kemitraan →</a></li>
							<li><a href="/tentang#editorial">Dewan Redaksi & Kebijakan</a></li>
							<li><a href="/kirim-tulisan#transliterasi">Standar Transliterasi Arab</a></li>
						</ul>
					</div>

					<!-- Column 4: Widget Area -->
					<div class="footer-col footer-widgets-section">
						<WidgetArea name="footer" />
					</div>
				</div>

				<div class="footer-bottom">
					<p class="footer-copyright">
						© {new Date().getFullYear()} <strong>Afaq Tafsir</strong>. Dikelola secara independen oleh Kader Ulama Perempuan PKUMI.
					</p>
					<div class="theme-switcher">
						<button
							type="button"
							class="theme-btn"
							data-theme="light"
							aria-label="Light mode"
						>
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="5"></circle>
								<line x1="12" y1="1" x2="12" y2="3"></line>
								<line x1="12" y1="21" x2="12" y2="23"></line>
								<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
								<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
								<line x1="1" y1="12" x2="3" y2="12"></line>
								<line x1="21" y1="12" x2="23" y2="12"></line>
								<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
								<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
							</svg>
						</button>
						<button
							type="button"
							class="theme-btn"
							data-theme="dark"
							aria-label="Dark mode"
						>
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
							</svg>
						</button>
						<button
							type="button"
							class="theme-btn"
							data-theme="system"
							aria-label="System theme"
						>
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
								<line x1="8" y1="21" x2="16" y2="21"></line>
								<line x1="12" y1="17" x2="12" y2="21"></line>
							</svg>
						</button>
					</div>
				</div>
			</div>
		</footer>

		<script>
			// Theme switcher
			const THEME_REGEX = /theme=([^;]+)/;
			const themeBtns =
				document.querySelectorAll<HTMLButtonElement>(".theme-btn");
			const root = document.documentElement;

			function setCookie(
				name: string,
				value: string,
				maxAge: number = 31536000
			) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (value === "") {
					document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax${secure}`;
				} else {
					document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
				}
			}

			function setTheme(theme: string) {
				if (theme === "system") {
					setCookie("theme", "");
					root.classList.remove("light", "dark");
				} else {
					setCookie("theme", theme);
					root.classList.remove("light", "dark");
					root.classList.add(theme);
				}
				updateActiveBtn(theme);
			}

			function updateActiveBtn(theme: string) {
				themeBtns.forEach((btn) => {
					btn.classList.toggle("active", btn.dataset.theme === theme);
				});
			}

			function getStoredTheme(): string {
				const match = document.cookie.match(THEME_REGEX);
				return match ? match[1] : "system";
			}

			// Initialize
			const storedTheme = getStoredTheme();
			setTheme(storedTheme);

			themeBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					setTheme(btn.dataset.theme || "system");
				});
			});
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
					box-sizing: border-box;
				}

				body,
				h1,
				h2,
				h3,
				h4,
				h5,
				h6,
				p,
				ul,
				ol,
				figure,
				blockquote,
				dl,
				dd {
					margin: 0;
				}

				ul,
				ol {
					padding: 0;
				}

				/*
				 * Design tokens live in src/styles/tokens.css. Colors are
				 * defined with light-dark(); these rules pin the scheme when
				 * the footer switcher sets an explicit choice. With no class,
				 * color-scheme: light dark follows the OS preference. The
				 * @supports guard keeps the toggle from forcing dark UA form
				 * controls on browsers stuck on the plain-light fallback.
				 */
				@supports (color: light-dark(#000, #fff)) {
					:root.light {
						color-scheme: light;
					}

					:root.dark {
						color-scheme: dark;
					}
				}

				html {
					scroll-behavior: smooth;
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-relaxed);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
					min-height: 100vh;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: var(--color-brand);
					text-decoration: none;
					transition: color var(--transition-fast);
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
					color: var(--color-brand-hover);
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					line-height: var(--leading-tight);
					font-weight: var(--font-weight-heading);
					letter-spacing: var(--tracking-snug);
				}

				h1 {
					font-weight: var(--font-weight-display);
					letter-spacing: var(--tracking-tight);
				}

				::selection {
					background: var(--color-brand);
					color: var(--color-on-brand);
				}
			}
		</style>

		<style>
			.site-header {
				position: sticky;
				top: 0;
				z-index: 900;
				background: rgba(255, 255, 255, 0.92);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				border-bottom: 1px solid var(--sky-200);
				transition: background var(--transition-fast), border-color var(--transition-fast);
			}

			:global(.dark) .site-header {
				background: rgba(8, 26, 47, 0.92);
				border-bottom: 1px solid rgba(52, 198, 244, 0.2);
			}

			.nav {
				display: flex;
				justify-content: space-between;
				align-items: center;
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 0.75rem var(--spacing-6);
				gap: var(--spacing-6);
			}

			/* Brand Logo & Title */
			.brand-link {
				display: flex;
				align-items: center;
				gap: 12px;
				text-decoration: none;
				flex-shrink: 0;
			}

			.brand-logo-img {
				width: 38px;
				height: auto;
				object-fit: contain;
				flex-shrink: 0;
			}

			.brand-text {
				display: flex;
				flex-direction: column;
			}

			.brand-title {
				font-family: var(--font-serif);
				font-size: 1.25rem;
				font-weight: 700;
				color: var(--blue-950);
				line-height: 1.15;
				letter-spacing: -0.02em;
			}

			:global(.dark) .brand-title {
				color: var(--white);
			}

			.brand-subtitle {
				font-family: var(--font-sans);
				font-size: 0.62rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				color: var(--text-brand);
				text-transform: uppercase;
				margin-top: 1px;
			}

			/* Center Nav Links */
			.nav-center {
				display: flex;
				align-items: center;
			}

			.nav-links {
				display: flex;
				align-items: center;
				gap: var(--spacing-6);
			}

			.nav-link {
				position: relative;
				font-family: var(--font-sans);
				font-size: 0.92rem;
				font-weight: 600;
				color: var(--slate-700);
				text-decoration: none;
				padding: 6px 2px;
				transition: color var(--transition-fast);
			}

			:global(.dark) .nav-link {
				color: var(--slate-300);
			}

			.nav-link:hover {
				color: var(--blue-950);
			}

			:global(.dark) .nav-link:hover {
				color: var(--white);
			}

			.nav-link.active {
				color: var(--blue-950);
			}

			:global(.dark) .nav-link.active {
				color: var(--sky-400);
			}

			/* Sky Gradient Active Indicator Bar */
			.nav-link.active::after {
				content: "";
				position: absolute;
				bottom: -2px;
				left: 0;
				right: 0;
				height: 2.5px;
				background: linear-gradient(90deg, var(--sky-500) 0%, var(--sky-300) 100%);
				border-radius: var(--radius-full);
			}

			/* Right Actions */
			.nav-right {
				display: flex;
				align-items: center;
				gap: var(--spacing-4);
				margin-inline-start: auto;
			}

			.btn-cta-submit {
				display: inline-flex;
				align-items: center;
				gap: 6px;
				background: var(--gold-500);
				color: var(--white);
				font-family: var(--font-sans);
				font-size: 0.85rem;
				font-weight: 700;
				padding: 7px 14px;
				border-radius: var(--radius-full);
				text-decoration: none;
				box-shadow: 0 2px 8px rgba(217, 119, 6, 0.25);
				transition: background var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
				white-space: nowrap;
			}

			.btn-cta-submit:hover {
				background: var(--gold-600);
				color: var(--white);
				transform: translateY(-1px);
				box-shadow: 0 4px 12px rgba(217, 119, 6, 0.35);
			}

			.nav-admin {
				font-size: 0.8rem;
				font-weight: 600;
				color: var(--text-brand);
				background: var(--sky-100);
				padding: 4px 10px;
				border-radius: var(--radius-full);
				text-decoration: none;
				transition: background var(--transition-fast);
			}

			.nav-admin:hover {
				background: var(--sky-200);
			}

			/* Search styling */
			.site-search {
				position: relative;
				width: 220px;
			}

			:global(.site-search-input) {
				width: 100% !important;
				padding: 7px 12px !important;
				font-family: var(--font-sans) !important;
				font-size: 0.85rem !important;
				border: 1px solid var(--sky-200) !important;
				border-radius: var(--radius-full) !important;
				background: var(--white) !important;
				color: var(--slate-800) !important;
				box-shadow: var(--shadow-sm);
				transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
			}

			:global(.dark) :global(.site-search-input) {
				background: var(--blue-900) !important;
				border-color: rgba(52, 198, 244, 0.3) !important;
				color: var(--white) !important;
			}

			:global(.site-search-input)::placeholder {
				color: var(--slate-400);
			}

			:global(.site-search-input):focus,
			:global(.site-search-input):focus-visible {
				outline: none;
				border-color: var(--sky-500) !important;
				box-shadow: 0 0 0 3px rgba(52, 198, 244, 0.25) !important;
			}

			:global(.site-search-results) {
				position: absolute;
				top: 100%;
				left: 0;
				right: 0;
				margin-top: 8px;
				background: var(--white);
				border: 1px solid var(--sky-200);
				border-radius: var(--radius-md);
				box-shadow: var(--shadow-lg);
				max-height: 400px;
				overflow-y: auto;
				z-index: 1000;
			}

			:global(.dark) :global(.site-search-results) {
				background: var(--blue-950);
				border-color: rgba(52, 198, 244, 0.25);
