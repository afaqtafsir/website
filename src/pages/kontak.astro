---
import Base from "../layouts/Base.astro";
---

<Base
	title="Kontak & Redaksi — Afaq Tafsir"
	description="Saluran komunikasi, alamat redaksi, dan kontak resmi tim jurnal Afaq Tafsir."
>
	<div class="contact-page-container">
		
		<header class="contact-header">
			<div class="badge-wrap">
				<span class="badge-gold">HUBUNGI KAMI</span>
			</div>
			<h1 class="contact-title">Kontak & Saluran Resmi Redaksi</h1>
			<p class="contact-lead">
				Silakan hubungi kami untuk keperluan korespondensi artikel, kerjasama kemitraan akademik, undangan forum ilmiah, atau pertanyaan umum.
			</p>
			<span class="amber-bar"></span>
		</header>

		<div class="contact-layout-grid">
			{/* Left Column: Direct Details */}
			<div class="contact-cards-stack">
				<div class="info-card">
					<div class="card-icon">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<rect width="20" height="16" x="2" y="4" rx="2"></rect>
							<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
						</svg>
					</div>
					<div class="card-content">
						<h3>Surel Editorial & Naskah</h3>
						<p><a href="mailto:afaqtafsir.id@gmail.com">afaqtafsir.id@gmail.com</a></p>
						<span class="sub-note">Waktu respon editorial: 1–3 hari kerja</span>
					</div>
				</div>

				<div class="info-card">
					<div class="card-icon">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
							<circle cx="12" cy="10" r="3"></circle>
						</svg>
					</div>
					<div class="card-content">
						<h3>Sekretariat Redaksi</h3>
						<p>Pendidikan Kader Ulama Masjid Istiqlal (PKUMI)</p>
						<p class="sub-note">Masjid Istiqlal, Jl. Taman Wijaya Kusuma, Ps. Baru, Sawah Besar, Jakarta Pusat, DKI Jakarta 10710</p>
					</div>
				</div>

				<div class="info-card">
					<div class="card-icon">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
						</svg>
					</div>
					<div class="card-content">
						<h3>Media Sosial & Komunitas</h3>
						<div class="social-links-row">
							<a href="https://instagram.com/afaqtafsir" target="_blank" rel="noopener">Instagram (@afaqtafsir)</a>
							<span>•</span>
							<a href="https://youtube.com/@afaqtafsir" target="_blank" rel="noopener">YouTube Kanal Kajian</a>
						</div>
					</div>
				</div>
			</div>

			{/* Right Column: Quick Contact Form */}
			<div class="contact-form-box">
				<h2 class="form-title">Kirim Pesan Langsung</h2>
				<p class="form-desc">Kirimkan catatan atau pesan singkat langsung ke kotak surat dewan redaksi.</p>
				
				<form class="contact-form" id="contactForm">
					<div class="form-group">
						<label for="name">Nama Lengkap *</label>
						<input type="text" id="name" required placeholder="Contoh: Ahmad Fauzi, M.Ag." />
					</div>
					<div class="form-group">
						<label for="email">Alamat Surel *</label>
						<input type="email" id="email" required placeholder="nama@email.com" />
					</div>
					<div class="form-group">
						<label for="subject">Subjek / Perihal *</label>
						<input type="text" id="subject" required placeholder="Pertanyaan / Kemitraan Ilmiah" />
					</div>
					<div class="form-group">
						<label for="message">Isi Pesan *</label>
						<textarea id="message" rows="5" required placeholder="Tuliskan pesan Anda secara rinci di sini..."></textarea>
					</div>
					<button type="submit" class="btn-submit-contact">Kirim Pesan Sekarang</button>
				</form>
				<script>
					const form = document.getElementById("contactForm");
					form?.addEventListener("submit", (e) => {
						e.preventDefault();
						alert("Terima kasih. Pesan Anda telah terkirim kepada dewan redaksi Afaq Tafsir.");
					});
				</script>
			</div>
		</div>

	</div>
</Base>

<style>
	.contact-page-container {
		max-width: 960px;
		margin: 0 auto;
		padding: var(--spacing-10) var(--spacing-6) var(--spacing-16);
	}

	.contact-header {
		margin-bottom: var(--spacing-10);
	}

	.badge-wrap {
		margin-bottom: var(--spacing-3);
	}

	.contact-title {
		font-size: 2.3rem;
		line-height: 1.25;
		color: var(--blue-950);
		margin: 0 0 var(--spacing-3);
	}

	:global(.dark) .contact-title {
		color: var(--white);
	}

	.contact-lead {
		font-size: 1.08rem;
		line-height: 1.7;
		color: var(--slate-700);
		margin-bottom: var(--spacing-4);
	}

	:global(.dark) .contact-lead {
		color: var(--slate-300);
	}

	.contact-layout-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing-8);
		align-items: start;
	}

	.contact-cards-stack {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-5);
	}

	.info-card {
		display: flex;
		gap: var(--spacing-4);
		padding: var(--spacing-5);
		background: var(--white);
		border: 1px solid var(--sky-200);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-sm);
	}

	:global(.dark) .info-card {
		background: var(--blue-950);
		border-color: rgba(52, 198, 244, 0.2);
	}

	.card-icon {
		width: 44px;
		height: 44px;
		background: var(--sky-100);
		color: var(--text-brand);
		border-radius: var(--radius-full);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.card-content h3 {
		font-size: 1rem;
		color: var(--blue-950);
		margin: 0 0 4px;
	}

	:global(.dark) .card-content h3 {
		color: var(--white);
	}

	.card-content p {
		margin: 0 0 4px;
		font-size: 0.92rem;
		color: var(--slate-700);
	}

	:global(.dark) .card-content p {
		color: var(--slate-300);
	}

	.card-content a {
		color: var(--text-brand);
		font-weight: 600;
		text-decoration: none;
	}

	.sub-note {
		font-size: 0.78rem;
		color: var(--slate-500);
		display: block;
	}

	.social-links-row {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 0.85rem;
	}

	/* Contact Form */
	.contact-form-box {
		background: var(--white);
		border: 1px solid var(--sky-200);
		border-radius: var(--radius-lg);
		padding: var(--spacing-6);
		box-shadow: var(--shadow-sm);
	}

	:global(.dark) .contact-form-box {
		background: var(--blue-950);
		border-color: rgba(52, 198, 244, 0.2);
	}

	.form-title {
		font-size: 1.35rem;
		color: var(--blue-950);
		margin: 0 0 var(--spacing-2);
	}

	:global(.dark) .form-title {
		color: var(--white);
	}

	.form-desc {
		font-size: 0.85rem;
		color: var(--slate-600);
		margin-bottom: var(--spacing-5);
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-4);
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.form-group label {
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--slate-700);
	}

	:global(.dark) .form-group label {
		color: var(--slate-300);
	}

	.form-group input,
	.form-group textarea {
		padding: 10px 12px;
		font-family: var(--font-sans);
		font-size: 0.9rem;
		border: 1px solid var(--sky-200);
		border-radius: var(--radius-sm);
		background: var(--white);
		color: var(--slate-800);
	}

	:global(.dark) .form-group input,
	:global(.dark) .form-group textarea {
		background: var(--blue-900);
		border-color: rgba(52, 198, 244, 0.25);
		color: var(--white);
	}

	.form-group input:focus,
	.form-group textarea:focus {
		outline: none;
		border-color: var(--text-brand);
	}

	.btn-submit-contact {
		padding: 12px;
		background: var(--blue-900);
		color: var(--white);
		font-family: var(--font-sans);
		font-size: 0.9rem;
		font-weight: 700;
		border: none;
		border-radius: var(--radius-md);
		cursor: pointer;
		transition: background var(--transition-fast);
	}

	.btn-submit-contact:hover {
		background: var(--blue-800);
	}

	@media (max-width: 768px) {
		.contact-layout-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
